{
  "name": "vp-residency-website",
  "version": "1.0.0",
  "private": true,
  "description": "VP Residency, Perambalur — hotel website with a built-in admin panel (Cloudflare Workers + D1 + R2)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply vp-residency-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply vp-residency-db --remote",
    "typecheck": "tsc --noEmit",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "lucide-static": "^1.52.0",
    "markdown-it": "^15.0.2",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261005.1",
    "@types/markdown-it": "^14.2.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.147.0"
  }
}
