{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vp-residency",
  "main": "src/index.tsx",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Static files (CSS, JS, placeholder art) are served straight from Cloudflare's edge.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vp-residency-db",
      "database_id": "5771456c-9bd4-4f13-9c26-ab70c410a9ca",
      "migrations_dir": "migrations"
    }
  ],
  // Optional: once R2 is enabled in the dashboard, create the bucket and uncomment this to store
  // uploads in R2 (10 GB free) instead of the D1 database (500 MB free).
  // "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "vp-residency-media" }],
  "observability": { "enabled": true }
}
